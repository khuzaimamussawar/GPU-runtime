# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-image-krea2-base:${IMAGE_TAG}

ARG KREA2_REPO=Comfy-Org/Krea-2
ARG KREA2_MODEL_FILE=diffusion_models/krea2_turbo_int8_convrot.safetensors
ARG KREA2_MODEL_SHA256=8e4eeda70dd5037ab1ba2bef6b417f9f901e26093117cf397f741fc1fdaaf3f1

LABEL org.opencontainers.image.title="scenebuilder-image-krea2-model-int8"
LABEL scene_builder.layer="image-krea2-model-int8"
LABEL scene_builder.krea2.quantization="int8-convrot"

RUN --mount=type=secret,id=hf_token set -eux; \
    python3 /opt/scenebuilder-image/scripts/download_hf_file.py \
      --token-file /run/secrets/hf_token \
      --repo "${KREA2_REPO}" \
      --file "${KREA2_MODEL_FILE}" \
      --out /opt/scenebuilder-models/krea2/diffusion_models/krea2_turbo_int8_convrot.safetensors; \
    echo "${KREA2_MODEL_SHA256}  /opt/scenebuilder-models/krea2/diffusion_models/krea2_turbo_int8_convrot.safetensors" | sha256sum -c -
