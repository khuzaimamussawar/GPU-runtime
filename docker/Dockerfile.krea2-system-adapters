# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-image-krea2-qwen-bf16:${IMAGE_TAG}

ARG KREA2_REPO=Comfy-Org/Krea-2
ARG STYLE_ADAPTER_FILE=loras/krea2_style_reference.safetensors
ARG STYLE_ADAPTER_SHA256=f50df5a9e62e4be8aa926a63dd5bb1a64770c4004f763c1208007ae13daa82b8

LABEL org.opencontainers.image.title="scenebuilder-image-krea2-system-adapters"
LABEL scene_builder.layer="image-krea2-system-adapters"

RUN --mount=type=secret,id=hf_token set -eux; \
    python3 /opt/scenebuilder-image/scripts/download_hf_file.py \
      --token-file /run/secrets/hf_token \
      --repo "${KREA2_REPO}" \
      --file "${STYLE_ADAPTER_FILE}" \
      --out /opt/scenebuilder-models/krea2/loras/krea2_style_reference.safetensors; \
    echo "${STYLE_ADAPTER_SHA256}  /opt/scenebuilder-models/krea2/loras/krea2_style_reference.safetensors" | sha256sum -c -
