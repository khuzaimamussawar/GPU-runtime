ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/minimax-h3-fl2va-loras:${IMAGE_TAG}

LABEL org.opencontainers.image.title="minimax-h3-runpod-fl2va"
LABEL scene_builder.runtime="runpod-fl2va"

# The CUDA/Ubuntu parent contains Debian's cryptography package without pip
# RECORD metadata. Current RunPod SDK requires a newer cryptography release, so
# install that wheel over the distro copy without asking pip to uninstall it.
RUN set -eux; \
    python3 -m pip install --no-cache-dir --ignore-installed "cryptography>=50.0.0"; \
    python3 -m pip install --no-cache-dir boto3 pillow "runpod==1.12.0"; \
    python3 - <<'PY'
import cryptography
import runpod
import boto3
print('cryptography', cryptography.__version__)
print('runpod SDK ready')
print('boto3', boto3.__version__)
PY

COPY src /opt/scenebuilder-h3/src
COPY scripts/cleanup_video.sh /opt/scenebuilder-h3/scripts/cleanup_video.sh
COPY scripts/encode_outputs.sh /opt/scenebuilder-h3/scripts/encode_outputs.sh

ENV SCENEBUILDER_VFX_CLEANUP_ENABLED=0
ENV SCENEBUILDER_VFX_CLEANUP_PROVIDER=maxine
ENV SCENEBUILDER_VFX_SUPPORTED_GPUS="NVIDIA L40,NVIDIA L4,NVIDIA A10,NVIDIA A16,NVIDIA A30,NVIDIA A40,NVIDIA A100,NVIDIA H100,NVIDIA A2,NVIDIA T4,NVIDIA B40,NVIDIA B100,NVIDIA B200"

WORKDIR /opt/scenebuilder-h3
CMD ["python3", "-m", "src.runpod.fl2va_handler"]
