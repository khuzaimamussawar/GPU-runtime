# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/minimax-h3-qwen-all:${IMAGE_TAG}
ARG H3_HF_REPO=Comfy-Org/MiniMax-H3

LABEL org.opencontainers.image.title="minimax-h3-fl2va-base"
LABEL scene_builder.layer="fl2va-model"

COPY scripts/download_hf_file.py /opt/scenebuilder-h3/scripts/download_hf_file.py

RUN mkdir -p /opt/ComfyUI/models/diffusion_models /opt/ComfyUI/models/vae
RUN --mount=type=secret,id=hf_token python3 /opt/scenebuilder-h3/scripts/download_hf_file.py \
    --token-file /run/secrets/hf_token \
    --repo "${H3_HF_REPO}" \
    --file "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors" \
    --out "/opt/ComfyUI/models/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors"
RUN --mount=type=secret,id=hf_token python3 /opt/scenebuilder-h3/scripts/download_hf_file.py \
    --token-file /run/secrets/hf_token \
    --repo "${H3_HF_REPO}" \
    --file "vae/minimax_h3_video_vae_fp16.safetensors" \
    --out "/opt/ComfyUI/models/vae/minimax_h3_video_vae_fp16.safetensors"
RUN --mount=type=secret,id=hf_token python3 /opt/scenebuilder-h3/scripts/download_hf_file.py \
    --token-file /run/secrets/hf_token \
    --repo "${H3_HF_REPO}" \
    --file "vae/minimax_h3_audio_vae_fp32.safetensors" \
    --out "/opt/ComfyUI/models/vae/minimax_h3_audio_vae_fp32.safetensors"
