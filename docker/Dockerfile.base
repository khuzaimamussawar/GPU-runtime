ARG CUDA_IMAGE=nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.13
ARG PYTHON_BIN=python3.13
ARG PYTORCH_VERSION=2.13.0
ARG PYTORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu130

# Pin the exact graph/runtime dependencies used by the checked-in API workflows.
ARG COMFYUI_COMMIT=34744cd29eacea9bbdec17e628a81c2ce0737d16
ARG KJNODES_COMMIT=073efb07419f56cc714e099a82e49fbc23ad9263
ARG SPECTRUM_COMMIT=1427dfe96029985be9cbc0033abb44bf2e7adc4f
ARG SAGEATTENTION_COMMIT=eb615cf6cf4d221338033340ee2de1c37fbdba4a

LABEL org.opencontainers.image.title="minimax-h3-base"
LABEL scene_builder.layer="base-cuda-pytorch-comfy"
LABEL scene_builder.cuda="13.0/cu130"
LABEL scene_builder.python="3.13"
LABEL scene_builder.pytorch="2.13"
LABEL scene_builder.comfyui.commit="${COMFYUI_COMMIT}"
LABEL scene_builder.kjnodes.commit="${KJNODES_COMMIT}"
LABEL scene_builder.spectrum.commit="${SPECTRUM_COMMIT}"
LABEL scene_builder.sageattention.commit="${SAGEATTENTION_COMMIT}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    ffmpeg \
    git \
    git-lfs \
    libgomp1 \
    ninja-build \
    software-properties-common \
    tini \
    wget \
  && add-apt-repository -y ppa:deadsnakes/ppa \
  && apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python${PYTHON_VERSION}-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/scenebuilder-h3

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | ${PYTHON_BIN}
RUN ln -sf /usr/bin/${PYTHON_BIN} /usr/local/bin/python3

RUN ${PYTHON_BIN} -m pip install --no-cache-dir --upgrade pip setuptools wheel packaging ninja
RUN ${PYTHON_BIN} -m pip install --no-cache-dir \
    torch==${PYTORCH_VERSION} \
    torchvision \
    torchaudio \
    --index-url ${PYTORCH_CUDA_INDEX}

# ComfyUI is pinned because the API workflow JSON depends on exact current H3 node
# classes and dynamic Ref2VA input names.
RUN git clone https://github.com/Comfy-Org/ComfyUI.git /opt/ComfyUI \
  && cd /opt/ComfyUI \
  && git checkout --detach ${COMFYUI_COMMIT}

WORKDIR /opt/ComfyUI
RUN ${PYTHON_BIN} -m pip install --no-cache-dir -r requirements.txt

# KJNodes provides PathchSageAttentionKJ used in both production workflows.
RUN mkdir -p /opt/ComfyUI/custom_nodes \
  && git clone https://github.com/kijai/ComfyUI-KJNodes.git /opt/ComfyUI/custom_nodes/ComfyUI-KJNodes \
  && cd /opt/ComfyUI/custom_nodes/ComfyUI-KJNodes \
  && git checkout --detach ${KJNODES_COMMIT} \
  && ${PYTHON_BIN} -m pip install --no-cache-dir -r requirements.txt

# H3-specific Spectrum node. v0.2.1 is pinned to the commit used while the
# SceneBuilder master workflows were authored.
RUN git clone https://github.com/xmarre/ComfyUI-Spectrum-MiniMax-H3.git /opt/ComfyUI/custom_nodes/ComfyUI-Spectrum-MiniMax-H3 \
  && cd /opt/ComfyUI/custom_nodes/ComfyUI-Spectrum-MiniMax-H3 \
  && git checkout --detach ${SPECTRUM_COMMIT}

# SageAttention 2.2 can be compiled on the CPU-only Hetzner builder when the
# target architectures are explicit. 8.9 covers RTX 4090 + L40S; 12.0 covers
# RTX 5090. CUDA 13.0 satisfies the package's CUDA >=12.8 requirement for sm120.
ENV CUDA_HOME=/usr/local/cuda
ENV TORCH_CUDA_ARCH_LIST="8.9;12.0"
ENV MAX_JOBS=4
ENV EXT_PARALLEL=2
RUN git clone https://github.com/thu-ml/SageAttention.git /tmp/SageAttention \
  && cd /tmp/SageAttention \
  && git checkout --detach ${SAGEATTENTION_COMMIT} \
  && ${PYTHON_BIN} -m pip install --no-cache-dir --no-build-isolation . \
  && rm -rf /tmp/SageAttention

# Fail the base build early if the Python-side pieces the workflow needs are not
# importable. CUDA kernels are exercised later in the real GPU smoke tests.
RUN ${PYTHON_BIN} - <<'PY'
import importlib.util
import torch

assert importlib.util.find_spec("sageattention"), "sageattention import missing"
assert torch.__version__.startswith("2.13"), torch.__version__
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("H3 custom-node source trees installed")
PY

WORKDIR /opt/scenebuilder-h3
COPY src/common /opt/scenebuilder-h3/src/common

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "src.common.healthcheck"]
