# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/minimax-h3-base:${IMAGE_TAG}

# Official SageAttention source pinned to SageAttention 2.2.0.
ARG SAGEATTENTION_COMMIT=eb615cf6cf4d221338033340ee2de1c37fbdba4a

LABEL org.opencontainers.image.title="minimax-h3-sageattention"
LABEL scene_builder.layer="shared-sageattention-wheel"
LABEL scene_builder.sageattention.version="2.2.0"
LABEL scene_builder.sageattention.commit="${SAGEATTENTION_COMMIT}"

# Compile once on the CPU-only Hetzner builder for the GPU architectures used by
# the RunPod/Novita H3 pools: sm80 (A100-class), sm86 (A40/A6000), sm89
# (RTX 4090/L40/L40S/RTX 6000 Ada), sm90 (H100/Hopper MIG), and sm120
# (RTX 5090/RTX PRO Blackwell). CUDA 13.0 in minimax-h3-base satisfies
# SageAttention's sm120 CUDA >= 12.8 check.
ENV CUDA_HOME=/usr/local/cuda
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0"
ENV MAX_JOBS=4
ENV EXT_PARALLEL=2

# SageAttention's 2.2.0 source expects these build-tool ranges. Keep them local
# to this artifact image; the final H3 images only receive the compiled wheel.
RUN python3 -m pip install --no-cache-dir \
      'setuptools>=62,<75' \
      'wheel>=0.38,<0.44' \
      'packaging>=21,<24' \
      ninja

RUN set -eux; \
    git clone https://github.com/thu-ml/SageAttention.git /tmp/SageAttention; \
    cd /tmp/SageAttention; \
    git checkout --detach "${SAGEATTENTION_COMMIT}"; \
    mkdir -p /artifacts/wheels; \
    python3 -m pip wheel \
      --no-cache-dir \
      --no-deps \
      --no-build-isolation \
      --wheel-dir /artifacts/wheels \
      .; \
    rm -rf /tmp/SageAttention

RUN python3 - <<'PY'
from pathlib import Path
wheels = list(Path('/artifacts/wheels').glob('sageattention-2.2.0-*.whl'))
assert len(wheels) == 1, wheels
print('SageAttention wheel:', wheels[0].name)
PY
