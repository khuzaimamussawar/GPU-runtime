# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/minimax-h3-pod-loras:${IMAGE_TAG}

LABEL org.opencontainers.image.title="minimax-h3-pod-workflow"
LABEL scene_builder.layer="pod-combined-workflows"
LABEL scene_builder.task_families="h3_fl2va,h3_ref2va"

# Workflows/manifests are deliberately the last family-content layer. By this
# point both diffusion families, tested ComfyUI, SageAttention, shared nodes,
# Spectrum, and both LoRA sets are already present.
COPY workflows/fl2va_master.json /opt/scenebuilder-h3/workflows/fl2va_master.json
COPY workflows/manifests/fl2va_manifest.json /opt/scenebuilder-h3/workflows/manifests/fl2va_manifest.json
COPY workflows/ref2va_master.json /opt/scenebuilder-h3/workflows/ref2va_master.json
COPY workflows/manifests/ref2va_manifest.json /opt/scenebuilder-h3/workflows/manifests/ref2va_manifest.json
COPY scripts/validate_workflows.py /opt/scenebuilder-h3/scripts/validate_workflows.py

RUN python3 /opt/scenebuilder-h3/scripts/validate_workflows.py \
      --workflow /opt/scenebuilder-h3/workflows/fl2va_master.json \
      --manifest /opt/scenebuilder-h3/workflows/manifests/fl2va_manifest.json \
 && python3 /opt/scenebuilder-h3/scripts/validate_workflows.py \
      --workflow /opt/scenebuilder-h3/workflows/ref2va_master.json \
      --manifest /opt/scenebuilder-h3/workflows/manifests/ref2va_manifest.json
