# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-image-krea2-nodes:${IMAGE_TAG}

LABEL org.opencontainers.image.title="scenebuilder-image-krea2-workflow"
LABEL scene_builder.layer="image-krea2-workflow"
LABEL scene_builder.task_families="krea2_image"
LABEL scene_builder.workflow_modes="lora,reference_images"

RUN mkdir -p /opt/scenebuilder-image/workflows/manifests /opt/scenebuilder-image/scripts

# One workflow layer deliberately contains both execution modes. They share the
# same Krea/Qwen/VAE/system-adapter runtime and differ only in graph structure.
COPY krea2/workflows/krea2_turbo.json /opt/scenebuilder-image/workflows/krea2_turbo.json
COPY krea2/workflows/krea2_style_reference.json /opt/scenebuilder-image/workflows/krea2_style_reference.json
COPY krea2/workflows/manifests/krea2_turbo.json /opt/scenebuilder-image/workflows/manifests/krea2_turbo.json
COPY krea2/workflows/manifests/krea2_style_reference.json /opt/scenebuilder-image/workflows/manifests/krea2_style_reference.json
COPY scripts/validate_workflows.py /opt/scenebuilder-image/scripts/validate_workflows.py

RUN set -eux; \
    python3 /opt/scenebuilder-image/scripts/validate_workflows.py \
      --workflow /opt/scenebuilder-image/workflows/krea2_turbo.json \
      --manifest /opt/scenebuilder-image/workflows/manifests/krea2_turbo.json; \
    python3 /opt/scenebuilder-image/scripts/validate_workflows.py \
      --workflow /opt/scenebuilder-image/workflows/krea2_style_reference.json \
      --manifest /opt/scenebuilder-image/workflows/manifests/krea2_style_reference.json
