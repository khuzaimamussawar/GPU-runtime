# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-image-krea2-vaes:${IMAGE_TAG}

ARG KREA2_REPO=Comfy-Org/Krea-2
ARG QWEN_FILE=text_encoders/qwen3vl_4b_bf16.safetensors
ARG QWEN_SHA256=36f3ff447ef59201722e8f9ce6020c9819fdcfba6aa2608c4e09b1c0ce114e34

LABEL org.opencontainers.image.title="scenebuilder-image-krea2-qwen-bf16"
LABEL scene_builder.layer="image-krea2-qwen-bf16"
LABEL scene_builder.krea2.text_encoder="qwen3vl_4b_bf16"

RUN --mount=type=secret,id=hf_token set -eux; \
    python3 /opt/scenebuilder-image/scripts/download_hf_file.py \
      --token-file /run/secrets/hf_token \
      --repo "${KREA2_REPO}" \
      --file "${QWEN_FILE}" \
      --out /opt/scenebuilder-models/krea2/text_encoders/qwen3vl_4b_bf16.safetensors; \
    echo "${QWEN_SHA256}  /opt/scenebuilder-models/krea2/text_encoders/qwen3vl_4b_bf16.safetensors" | sha256sum -c -
