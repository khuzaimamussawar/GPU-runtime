# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest

# Reuse the already-built Serverless artifacts. Nothing in this target downloads
# H3/Qwen/VAE weights from Hugging Face and SageAttention is NOT recompiled.
FROM ${REGISTRY_NAMESPACE}/minimax-h3-comfyui:${IMAGE_TAG} AS comfyui_artifact
FROM ${REGISTRY_NAMESPACE}/minimax-h3-sageattention:${IMAGE_TAG} AS sageattention_artifact
FROM ${REGISTRY_NAMESPACE}/minimax-h3-ref2va-base:${IMAGE_TAG} AS ref2va_model_artifact

# FL2VA base already contains CUDA/Python/PyTorch, both Qwen encoders, FL2VA
# diffusion, and the shared video/audio VAEs.
FROM ${REGISTRY_NAMESPACE}/minimax-h3-fl2va-base:${IMAGE_TAG}

ARG COMFYUI_COMMIT=2a68ce33b4c9ea6ee4283e618a74560cefb32694
ARG SAGEATTENTION_VERSION=2.2.0

LABEL org.opencontainers.image.title="minimax-h3-pod-models"
LABEL scene_builder.layer="pod-fl2va-sage-ref2va-model"
LABEL scene_builder.task_families="h3_fl2va,h3_ref2va"
LABEL scene_builder.comfyui.commit="${COMFYUI_COMMIT}"
LABEL scene_builder.sageattention.version="${SAGEATTENTION_VERSION}"

# Apply the exact tested ComfyUI source artifact used by the Serverless workflow
# images, while preserving the models already present in fl2va-base.
COPY --from=comfyui_artifact /artifacts/comfyui-overlay.tar.gz /tmp/comfyui-overlay.tar.gz
COPY --from=comfyui_artifact /artifacts/COMFYUI_COMMIT /tmp/COMFYUI_COMMIT
RUN set -eux; \
    test "$(cat /tmp/COMFYUI_COMMIT)" = "${COMFYUI_COMMIT}"; \
    find /opt/ComfyUI -mindepth 1 -maxdepth 1 \
      ! -name models \
      ! -name custom_nodes \
      ! -name input \
      ! -name output \
      ! -name temp \
      ! -name user \
      -exec rm -rf {} +; \
    tar -xzf /tmp/comfyui-overlay.tar.gz -C /opt/ComfyUI; \
    python3 -m pip install --no-cache-dir -r /opt/ComfyUI/requirements.txt; \
    rm -f /tmp/comfyui-overlay.tar.gz /tmp/COMFYUI_COMMIT

# Install the already-compiled SageAttention 2.2 wheel. This is a wheel install,
# not an NVCC/source rebuild. The shared artifact stays the one source of truth.
COPY --from=sageattention_artifact /artifacts/wheels/ /tmp/sage-wheels/
RUN set -eux; \
    python3 -m pip install --no-cache-dir /tmp/sage-wheels/sageattention-2.2.0-*.whl; \
    python3 - <<'PY'
import importlib.metadata
assert importlib.metadata.version('sageattention') == '2.2.0'
print('SageAttention 2.2.0 installed from existing wheel')
PY
RUN rm -rf /tmp/sage-wheels

# Add only the one heavyweight model missing from the FL2VA lineage: Ref2VA
# diffusion. The file is copied from the already-built Ref2VA base image.
COPY --from=ref2va_model_artifact \
    /opt/ComfyUI/models/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors \
    /opt/ComfyUI/models/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors

RUN python3 - <<'PY'
from pathlib import Path
required = [
    '/opt/ComfyUI/models/clip/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors',
    '/opt/ComfyUI/models/clip/qwen3vl_32b_minimax_h3_int8_convrot.safetensors',
    '/opt/ComfyUI/models/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors',
    '/opt/ComfyUI/models/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors',
    '/opt/ComfyUI/models/vae/minimax_h3_video_vae_fp16.safetensors',
    '/opt/ComfyUI/models/vae/minimax_h3_audio_vae_fp32.safetensors',
]
for raw in required:
    path = Path(raw)
    assert path.is_file(), raw
    assert path.stat().st_size > 1024 * 1024, f'Unexpectedly small model file: {raw}'
    print(path.name, path.stat().st_size)
PY
