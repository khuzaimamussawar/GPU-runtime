# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-enhancer-vfi-models:${IMAGE_TAG}

ARG REALESRGAN_COMMIT=a4abfb2979a7bbff3f69f58f58ae324608821e27

LABEL org.opencontainers.image.title="scenebuilder-enhancer-esrgan-models"
LABEL scene_builder.layer="enhancer-esrgan-models"
LABEL scene_builder.realesrgan.commit="${REALESRGAN_COMMIT}"

RUN set -eux; \
    git clone https://github.com/xinntao/Real-ESRGAN.git /opt/Real-ESRGAN; \
    cd /opt/Real-ESRGAN; \
    git checkout "${REALESRGAN_COMMIT}"; \
    python3 -m pip install basicsr>=1.4.2 facexlib>=0.2.5 gfpgan>=1.3.5 tqdm; \
    python3 -m pip install --no-deps -e /opt/Real-ESRGAN; \
    python3 - <<'PY'
from pathlib import Path
import basicsr
root = Path(basicsr.__file__).resolve().parent
path = root / 'data' / 'degradations.py'
if path.is_file():
    text = path.read_text()
    text = text.replace('from torchvision.transforms.functional_tensor import rgb_to_grayscale',
                        'from torchvision.transforms.functional import rgb_to_grayscale')
    path.write_text(text)
print('patched', path)
PY

RUN set -eux; \
    mkdir -p /opt/Real-ESRGAN/weights; \
    curl -fL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth \
      -o /opt/Real-ESRGAN/weights/RealESRGAN_x4plus.pth; \
    curl -fL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth \
      -o /opt/Real-ESRGAN/weights/RealESRGAN_x4plus_anime_6B.pth; \
    curl -fL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-animevideov3.pth \
      -o /opt/Real-ESRGAN/weights/realesr-animevideov3.pth; \
    curl -fL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-x4v3.pth \
      -o /opt/Real-ESRGAN/weights/realesr-general-x4v3.pth; \
    curl -fL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-wdn-x4v3.pth \
      -o /opt/Real-ESRGAN/weights/realesr-general-wdn-x4v3.pth; \
    test -s /opt/Real-ESRGAN/weights/RealESRGAN_x4plus.pth; \
    test -s /opt/Real-ESRGAN/weights/RealESRGAN_x4plus_anime_6B.pth; \
    test -s /opt/Real-ESRGAN/weights/realesr-animevideov3.pth; \
    test -s /opt/Real-ESRGAN/weights/realesr-general-x4v3.pth

RUN set -eux; \
    mkdir -p /opt/scenebuilder-models/onnx; \
    curl -fL https://huggingface.co/tidus2102/Real-ESRGAN/resolve/702b70a0ad2e5053cf3a3ec72c25fce2a9d9b630/RealESR-AnimeVideo-v3_x4.onnx \
      -o /opt/scenebuilder-models/onnx/realesr-animevideov3.onnx; \
    curl -fL https://huggingface.co/CoderViking/realesr-general-x4v3-onnx/resolve/main/realesr-general-x4v3.onnx \
      -o /opt/scenebuilder-models/onnx/realesr-general-x4v3.onnx; \
    echo "00ece3ac21c43ee31459216b5174b2cea0c5325044c5142aeb840f4890e175ff  /opt/scenebuilder-models/onnx/realesr-animevideov3.onnx" | sha256sum -c -; \
    echo "1940a93ee08283a0a7286183186357b1688fe9fa8ede74604b424586aaddf112  /opt/scenebuilder-models/onnx/realesr-general-x4v3.onnx" | sha256sum -c -; \
    test -s /opt/scenebuilder-models/onnx/realesr-animevideov3.onnx; \
    test -s /opt/scenebuilder-models/onnx/realesr-general-x4v3.onnx

ENV REAL_ESRGAN_ROOT=/opt/Real-ESRGAN
CMD ["python3", "-c", "import realesrgan; print('Real-ESRGAN layer ready')"]
