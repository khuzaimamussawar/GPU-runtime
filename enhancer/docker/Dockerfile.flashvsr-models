# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-enhancer-flashvsr-runtime:${IMAGE_TAG}

LABEL org.opencontainers.image.title="scenebuilder-enhancer-flashvsr-models"
LABEL scene_builder.layer="enhancer-flashvsr-models"
LABEL scene_builder.model="flashvsr-v1.1"

COPY scripts/download_model_assets.py /opt/scenebuilder-enhancer-build/download_model_assets.py
RUN --mount=type=secret,id=hf_token,required=false set -eux; \
    export HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || true)"; \
    python3 /opt/scenebuilder-enhancer-build/download_model_assets.py flashvsr --root /opt/scenebuilder-models; \
    test -d /opt/scenebuilder-models/flashvsr-v1.1; \
    rm -rf /opt/FlashVSR/examples/WanVSR/FlashVSR-v1.1; \
    ln -s /opt/scenebuilder-models/flashvsr-v1.1 /opt/FlashVSR/examples/WanVSR/FlashVSR-v1.1

ENV FLASHVSR_MODEL_DIR=/opt/scenebuilder-models/flashvsr-v1.1
CMD ["python3", "-c", "from pathlib import Path; assert Path('/opt/scenebuilder-models/flashvsr-v1.1').is_dir(); print('FlashVSR models ready')"]
