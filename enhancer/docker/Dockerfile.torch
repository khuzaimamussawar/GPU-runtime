# syntax=docker/dockerfile:1.7
ARG REGISTRY_NAMESPACE
ARG IMAGE_TAG=latest
FROM ${REGISTRY_NAMESPACE}/scenebuilder-enhancer-base:${IMAGE_TAG}

ARG PYTORCH_VERSION=2.13.0
ARG TORCHVISION_VERSION=0.28.0
ARG PYTORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu130
ARG TENSORRT_VERSION=10.14.1.48
ARG TENSORRT_PIP_VERSION=10.14.1.48.post1

LABEL org.opencontainers.image.title="scenebuilder-enhancer-torch"
LABEL scene_builder.layer="enhancer-torch-cupy-trt"
LABEL scene_builder.cuda="13.0.2/cu130"
LABEL scene_builder.pytorch="2.13.0"
LABEL scene_builder.tensorrt="10.14.1.48"

RUN set -eux; \
    python3 -m pip install \
      torch==${PYTORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
      --index-url ${PYTORCH_CUDA_INDEX}; \
    python3 -m pip install \
      cupy-cuda13x \
      tensorrt==${TENSORRT_PIP_VERSION} \
      boto3 fastapi 'uvicorn[standard]' pydantic pillow numpy scipy \
      opencv-python-headless pynvml huggingface_hub safetensors einops timm yacs loguru imageio imageio-ffmpeg av; \
    python3 - <<'PY'
import importlib.metadata as md
import torch
import cupy
import tensorrt
assert torch.__version__.split('+')[0] == '2.13.0', torch.__version__
assert str(torch.version.cuda).startswith('13.0'), torch.version.cuda
assert tensorrt.__version__ == '10.14.1.48', tensorrt.__version__
print('torch', torch.__version__)
print('torch.cuda', torch.version.cuda)
print('cupy', cupy.__version__)
print('tensorrt', tensorrt.__version__)
print('pynvml', md.version('nvidia-ml-py'))
PY

CMD ["python3", "-c", "import torch, cupy, tensorrt; print(torch.__version__, cupy.__version__, tensorrt.__version__)"]
